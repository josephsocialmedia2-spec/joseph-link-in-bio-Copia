  "functions": [
    {
      "sql": "CREATE OR REPLACE FUNCTION case247_private.enforce_property_dispatch()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\ndeclare cfg record; req record; camp record;\nbegin\n  if NEW.status not in ('QUEUED','SENT') then return NEW; end if;\n  select * into cfg from public.case247_optin_settings where organization_id=NEW.organization_id;\n  select * into req from public.case247_property_requests where id=NEW.request_id and organization_id=NEW.organization_id;\n  select * into camp from public.case247_property_campaigns where id=NEW.campaign_id and organization_id=NEW.organization_id;\n  if cfg is null or req is null or camp is null then\n    raise exception 'CASE247_ORGANIZATION_MISMATCH';\n  end if;\n  if not cfg.intake_enabled or not cfg.privacy_notice_approved or\n    not camp.rights_to_promote_verified or not camp.reviewed_by_staff or\n    camp.campaign_status <> 'APPROVED' then\n      raise exception 'CASE247_CAMPAIGN_NOT_APPROVED';\n  end if;\n  if req.status <> 'VERIFIED' or req.revoked_at is not null or\n    req.expiry_at <= now() then raise exception 'CASE247_NO_VALID_SUBSCRIPTION'; end if;\n  if (NEW.channel='email' and (not cfg.email_outbound_enabled or not req.email_optin_requested or req.email_verified_at is null))\n    or (NEW.channel='whatsapp' and (not cfg.whatsapp_outbound_enabled or not req.whatsapp_optin_requested or req.whatsapp_verified_at is null))\n  then raise exception 'CASE247_CHANNEL_CONSENT_NOT_VERIFIED'; end if;\n  return NEW;\nend $function$\n",
      "name": "enforce_property_dispatch"
    },
    {
      "sql": "CREATE OR REPLACE FUNCTION case247_private.log_property_request_evidence()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\nbegin\n if tg_op='INSERT' then\n  insert into public.case247_property_request_events(organization_id,request_id,event_type,evidence)\n  values (new.organization_id,new.id,'SUBMITTED',jsonb_build_object(\n    'notice_version',new.notice_version,'request_kind',new.request_kind,\n    'email_optin',new.email_optin_requested,'whatsapp_optin',new.whatsapp_optin_requested,\n    'origin',new.origin_url,'submitted_at',new.requested_at));\n  if new.email_optin_requested then\n    insert into public.case247_property_request_events(organization_id,request_id,event_type,evidence)\n    values(new.organization_id,new.id,'EMAIL_OPTIN_REQUESTED',jsonb_build_object(\n       'consent_text',new.consent_text_email,'notice_version',new.notice_version));\n  end if;\n  if new.whatsapp_optin_requested then\n    insert into public.case247_property_request_events(organization_id,request_id,event_type,evidence)\n    values(new.organization_id,new.id,'WHATSAPP_OPTIN_REQUESTED',jsonb_build_object(\n       'consent_text',new.consent_text_whatsapp,'notice_version',new.notice_version));\n  end if;\n elsif tg_op='UPDATE' then\n  if new.status='CANCELLED' and old.status is distinct from 'CANCELLED' then\n   insert into public.case247_property_request_events(organization_id,request_id,event_type,evidence)\n   values(new.organization_id,new.id,'REVOKED',jsonb_build_object('at',new.revoked_at,'source','selfservice_token'));\n  end if;\n  if new.email_verified_at is not null and old.email_verified_at is null then\n   insert into public.case247_property_request_events(organization_id,request_id,event_type,evidence)\n   values(new.organization_id,new.id,'EMAIL_CONFIRMED',jsonb_build_object('at',new.email_verified_at));\n  end if;\n  if new.whatsapp_verified_at is not null and old.whatsapp_verified_at is null then\n   insert into public.case247_property_request_events(organization_id,request_id,event_type,evidence)\n   values(new.organization_id,new.id,'WHATSAPP_CONFIRMED',jsonb_build_object('at',new.whatsapp_verified_at));\n  end if;\n end if;\n return new;\nend $function$\n",
      "name": "log_property_request_evidence"
    },
    {
      "sql": "CREATE OR REPLACE FUNCTION case247_private.purge_expired_capture_requests()\n RETURNS integer\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\ndeclare ids uuid[]; n integer:=0;\nbegin\n select array_agg(r.id) into ids\n from public.case247_property_requests r\n where (\n   (r.status='PENDING_VERIFICATION' and r.expiry_at<now())\n   or (r.status='CANCELLED' and r.revoked_at<now()-interval '30 days')\n ) and not exists(\n  select 1 from public.case247_property_dispatch_jobs d\n  where d.request_id=r.id and d.status='SENT'\n );\n if ids is null then return 0; end if;\n delete from public.case247_property_dispatch_jobs where request_id=any(ids);\n delete from public.case247_property_request_events where request_id=any(ids);\n delete from public.case247_property_requests where id=any(ids);\n get diagnostics n=row_count;\n return n;\nend $function$\n",
      "name": "purge_expired_capture_requests"
    }
  ],
  "captured_at": "2026-11-02"
}
