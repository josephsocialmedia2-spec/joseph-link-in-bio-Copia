# Inserire soltanto nei segreti Vercel. Non caricare .env.local in GitHub.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=ztd-documents
# Supabase Auth: accesso con magic link; indirizzi in minuscolo separati da virgola
ZTD_ADMIN_EMAILS=
ZTD_APPROVER_EMAILS=
# Google OAuth 2.0 a nome del proprietario della cartella Drive (non service account My Drive)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=1oHla667gbs3cCIPx4_JITkrd-gRQ-oyK
# Calendar readonly obbligatorio se vuoi avere impegni scolastici importati realmente
GOOGLE_CALENDAR_ID=primary
# Sorgente verificata nel repository; non usare URL scelti dall'utente
GITHUB_REPOSITORY=josephsocialmedia2-spec/joseph-link-in-bio-Copia
GITHUB_DRAFT_REF=main
GITHUB_TOKEN=
# Dominio DEFINITIVO della nuova app, non dominio della preview static
APP_BASE_URL=
CRON_SECRET=
# Gate di activation: deve essere true soltanto DOPO collaudi DB/OAuth e QA
ZTD_AUTOMATION_ENABLED=false
